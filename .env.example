OWNER_UUID=replace-with-owner-uuid
MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=1.20.4
BOT_NAME=Companion
# COMPANION_DATA_DIR=./data

BRAIN_PROVIDER=gemini
BRAIN_BASE_URL=https://generativelanguage.googleapis.com/v1beta
BRAIN_API_KEY=replace-with-gemini-api-key
BRAIN_MODEL=gemini-3.8-flash
BRAIN_SPEAK_MODEL=gemini-3.8-flash
BRAIN_SPEAK_THINKING=low
BRAIN_PARSE_MODEL=gemini-3.8-flash
BRAIN_PARSE_THINKING=medium
BRAIN_FALLBACK_MODELS=gemini-3.5-flash-lite
BRAIN_SPEAK_TIMEOUT_MS=6000
BRAIN_PARSE_TIMEOUT_MS=15000
# Optional Windows speaker output; Gemini shares BRAIN_BASE_URL and BRAIN_API_KEY.
TTS_ENABLED=0
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_FALLBACK_MODELS=gemini-3.8-flash-tts
TTS_VOICE=Leda
TTS_TIMEOUT_MS=15000
TTS_VOLUME=80
# TypeSafe Jev (optional; required for autonomous intent execution)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=2000
JEV_CONFIDENCE_MIN=0.7
LEARNING_AUTONOMY=2
# OPENROUTER_API_KEY: 只供 TTS 使用的密钥
# TTS_PRIMARY: fish（默认）或 gemini，决定提供方顺序
# TTS_FISH_MODEL: 默认 fish-audio/s2.1-pro-free:free
# TTS_FISH_VOICE: 可选音色 id，只允许 1–64 位字母、数字、下划线和连字符
# PI_BIN: Windows executable (.cmd is launched via cmd.exe /d /c)
PI_BIN=pi
# PI_HOME: isolated directory resolved relative to companion; credentials managed externally
PI_HOME=pi-home
# AGENT_MODEL defaults to openrouter/thinkingmachines/inkling:free (passed to pi --model).
# AGENT_TIMEOUT_MS defaults to 20000; total per-run timeout, sends abort.
# AGENT_MAX_TOOL_ROUNDS defaults to 6; tool execution start count fuse.
# OPENROUTER_DAILY_LIMIT defaults to 1000; local-date agent.call event quota.
# AGENT_MODEL: default thinkingmachines/inkling:free
AGENT_MODEL=
# AGENT_TIMEOUT_MS: default 20000
AGENT_TIMEOUT_MS=
# AGENT_MAX_TOOL_ROUNDS: default 6
AGENT_MAX_TOOL_ROUNDS=
# OPENROUTER_DAILY_LIMIT: default 1000 calls per local day
OPENROUTER_DAILY_LIMIT=
